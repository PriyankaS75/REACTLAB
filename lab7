body {
  margin: 0;
  font-family: Arial, sans-serif;
}

.container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: #f0f0f0;
}

.card {
  width: 250px;
  padding: 20px;
  border-radius: 15px;
  text-align: center;
  transition: 0.3s ease;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.pic {
  width: 100%;
  height: auto;
  border-radius: 10px;
}



