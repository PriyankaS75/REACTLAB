index.css



body {
  margin: 0;
  font-family: Arial, sans-serif;
}

.navbar {
  display: flex;
  justify-content: center;
  padding: 15px;
  border-bottom: 1px solid #ccc;
}

.page {
  height: 90vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.home-bg {
  background-color: #e6f7ff;
}

.about-bg {
  background-color: #ffe6f0;
}

.contact-bg {
  background-color: #f2f2f2;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  width: 260px;
  text-align: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.home-text {
  color: #007BFF;
}

.about-text {
  color: #d63384;
}

.contact-text {
  color: #333;
}

.tag {
  background: #cce5ff;
  padding: 5px 10px;
  border-radius: 10px;
}

.btn {
  margin-top: 10px;
  padding: 8px 15px;
  border: none;
  background: #007BFF;
  color: white;
  border-radius: 5px;
  cursor: pointer;
}



