body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #dcdcdc;
}

/* MAIN CARD */
.app {
  width: 500px;
  margin: 80px auto;
  background: #f5f5f5;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
}

/* TITLE */
h1 {
  text-align: center;
  font-size: 40px;
  margin-bottom: 20px;
}

/* FORM */
form {
  display: flex;
  flex-direction: column;
}

form input {
  padding: 12px;
  margin: 10px 0;
  border-radius: 10px;
  border: 1px solid #ccc;
  font-size: 15px;
}

/* ADD BUTTON */
form button {
  padding: 12px;
  border: none;
  border-radius: 10px;
  background: #4da3d9;
  color: white;
  font-size: 16px;
  cursor: pointer;
  transition: 0.3s;
}

form button:hover {
  background: #3a8ec2;
}

/* FILTER BUTTONS */
.filters {
  display: flex;
  justify-content: space-between;
  margin: 20px 0;
}

.filters button {
  width: 30%;
  padding: 10px;
  border-radius: 10px;
  border: none;
  background: #ddd;
  cursor: pointer;
  transition: 0.3s;
}

.filters button:hover {
  background: #bbb;
}

/* TASK LIST */
ul {
  list-style: none;
  padding: 0;
}

li {
  background: #eaeaea;
  margin: 10px 0;
  padding: 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: 0.3s;
}

/* HOVER EFFECT */
li:hover {
  transform: scale(1.02);
  background: #dcdcdc;
}

/* DONE TASK */
li.done {
  text-decoration: line-through;
  text-decoration-thickness: 3px;
  text-decoration-color: black;
  color: #777;
}
